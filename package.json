{
  "name": "@johnmorrisdotca/address-plus",
  "version": "1.7.0",
  "description": "address-plus アドレスプラス — US and Canadian address parser: parse, validate, format and compare addresses, with Japanese support and modules for Australia, France, Germany and the UK. TypeScript, batch tools and an optional form field.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jp": {
      "types": "./dist/jp/index.d.ts",
      "import": "./dist/jp/index.js",
      "require": "./dist/jp/index.cjs"
    },
    "./au": {
      "types": "./dist/au/index.d.ts",
      "import": "./dist/au/index.js",
      "require": "./dist/au/index.cjs"
    },
    "./gb": {
      "types": "./dist/gb/index.d.ts",
      "import": "./dist/gb/index.js",
      "require": "./dist/gb/index.cjs"
    },
    "./de": {
      "types": "./dist/de/index.d.ts",
      "import": "./dist/de/index.js",
      "require": "./dist/de/index.cjs"
    },
    "./fr": {
      "types": "./dist/fr/index.d.ts",
      "import": "./dist/fr/index.js",
      "require": "./dist/fr/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "require": "./dist/element-define.cjs"
    }
  },
  "sideEffects": [
    "./dist/element-define.js",
    "./dist/element-define.cjs"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsd --files src/__tests__/types.test-d.ts",
    "schema:validate": "node scripts/validate-schemas.js",
    "test:package": "node scripts/check-package.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:check && pnpm docs:legacy-check && pnpm test:types && pnpm schema:validate && pnpm test:package",
    "release": "node scripts/release.mjs",
    "data:jp": "node scripts/jp/update-jp-data.ts",
    "data:sub-regions": "node scripts/sub-regions/update-sub-regions.ts",
    "data:countries": "node scripts/countries/update-country-data.ts",
    "prepublishOnly": "pnpm check",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "docs:make": "node scripts/docs.mjs",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "docs:legacy-check": "node scripts/check-docs.mjs",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "size": "node scripts/docs-site.mjs size"
  },
  "keywords": [
    "address",
    "address-parser",
    "australia",
    "australia-post",
    "bilingual",
    "canada",
    "canada-post",
    "cedex",
    "deutsche-post",
    "france",
    "germany",
    "japan",
    "la-poste",
    "parse-address",
    "parser",
    "plz",
    "postal-code",
    "postcode",
    "royal-mail",
    "typescript",
    "united-kingdom",
    "us",
    "usps",
    "zip-code"
  ],
  "author": "John Morris",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/address-plus.git"
  },
  "homepage": "https://johnmorrisdotca.github.io/address-plus/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/address-plus/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/hikidashi": "^1.0.2",
    "@johnmorrisdotca/kuni": "1.1.0",
    "@playwright/test": "^1.64.0",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.0",
    "eslint": "^9.0.0",
    "parse-address": "^1.1.2",
    "prettier": "^3.9.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsd": "^0.33.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0",
    "pagefind": "^1.5.2",
    "marked": "^18.0.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "fast-levenshtein": "^3.0.0"
  }
}
